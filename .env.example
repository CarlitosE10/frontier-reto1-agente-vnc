# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.

# --- API del agente ---
# Token del equipo que entrega la organización (empieza con ftr_). El evaluador lo envía en
# Authorization: Bearer <token> y nuestra API lo exige. Es el mismo para todo el equipo.
TEAM_TOKEN=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- Modelo ---
VLM_MODEL=anthropic/claude-haiku-5.5
# pixels para Claude y GPT; norm1000 para Qwen y Gemini
VLM_COORD_MODE=pixels
VLM_REASONING_EFFORT=low
# Verificación con el VLM antes de acciones irreversibles y antes de reportar éxito
VERIFY_ENABLED=true
# Modelo de la verificación. Vacío: usa VLM_MODEL
VERIFY_MODEL=

# --- Presupuestos por tarea ---
TASK_TIME_BUDGET_S=270
TASK_MAX_STEPS=40
TASK_MAX_COST_USD=0.15

# --- Interacción con el escritorio ---
CLICK_HOLD_MS=150
DOUBLE_CLICK_HOLD_MS=120
CHANGE_TIMEOUT_S=1.2
STABLE_INTERVAL_S=0.25
STABLE_TIMEOUT_S=1.5
DIFF_MIN_PIXELS=50
IRREVERSIBLE_KEYWORDS=guardar,aplicar,grabar,crear,registrar,actualizar,aceptar,confirmar,sí,eliminar,borrar,anular,exportar,descargar,generar,procesar,aprobar,finalizar,enviar

# --- Contexto y trazas ---
HISTORY_STEPS=10
EVIDENCE_SCREENS=12
TRACE_DIR=./traces

# --- Arnés de evaluación y comparación de modelos (solo en local) ---
# Datos de tu escritorio, de la tarjeta del reto en /evento
EVAL_DESKTOP_URL=wss://<tu-escritorio>/websockify
EVAL_DESKTOP_PASSWORD=
# Token para /__reset y /__check del escritorio
EVAL_DESKTOP_TOKEN=
# Agente contra el que corre el arnés y el token que le envía (el mismo valor de TEAM_TOKEN)
AGENT_URL=http://localhost:8000
AGENT_TOKEN=
